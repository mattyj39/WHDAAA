    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>Terrificante.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005045Z" creationid="demon" creationdate="20261118T005045Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>Ti dico che è tutto finto!"&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005049Z" creationid="demon" creationdate="20261118T005049Z">
