<tmx version="1.1">
  <header creationtool="OmegaT" o-tmf="OmegaT TMX" adminlang="EN-US" datatype="plaintext" creationtoolversion="6.1.1_0_9a3f59119" segtype="sentence" srclang="en-US"/>
  <body>
<!-- Default translations -->
    <tu>
      <tuv lang="en-US">
        <seg>"Conosci Natsuki Subaru già da prima?</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005052Z" creationid="demon" creationdate="20261118T005052Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Cosa vuoi dire?!"&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005049Z" creationid="demon" creationdate="20261118T005049Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Eh!</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T003347Z" creationid="demon" creationdate="20261118T003347Z">
        <seg>[fuzzy]Come hai combinato questo disordine per Emilia-sama?"&lt;/em&gt;&lt;/p&gt; &lt;p&gt;&lt;em&gt;Il ragazzo si mostrò tradito per un momento, prima di infuriarsi.</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Felt-sama, per favore.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005046Z" creationid="demon" creationdate="20261118T005046Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Fufuf~!</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005055Z" creationid="demon" creationdate="20261118T003214Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;[fuzzy]"Fufuf~! Pensi che io sia bloccata con tutti voi?!</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"L'unico posto in cui potrei pentirmi di andare è vicino a te o lascarti baciare la mia scarpa invece di guardarla, sudicia mezzo-demone.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005055Z" creationid="demon" creationdate="20261118T005055Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Mi dispiace interrompervi, Felt-sama, Karsten-sama.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005048Z" creationid="demon" creationdate="20261118T005048Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Non ha molto senso che &lt;em&gt;tutti&lt;/em&gt; noi siamo finiti nello stesso posto, non pensate?</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005050Z" creationid="demon" creationdate="20261118T005050Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Non parlare come se fosse colpa del capo, hai capito?!"&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005041Z" creationid="demon" creationdate="20261118T005041Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Non posso credere che il fratellone si farebbe fuori in quel modo." Felt scosse la testa dalla tristezza mentre ricordava l'immagine del suicidio del ragazzo.&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005051Z" creationid="demon" creationdate="20261118T005051Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Non vi permetterò di macchiare il nome del mio fantastico cavaliere dandogli del codardo.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005054Z" creationid="demon" creationdate="20261118T005054Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Non è semplicemente il fatto che &lt;em&gt;noi&lt;/em&gt; fossimo tutti morti a terra." Ignorò il fatto che il suo cavaliere trasalì e strinse i suoi pugni più forte.&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005051Z" creationid="demon" creationdate="20261118T005051Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Q-Quello che intendevo era che avete ignorato il resto di questa visione… Potremmo imparare qualcosa-"&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005049Z" creationid="demon" creationdate="20261118T005049Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Sarebbe saggio smettere di incitare scontri inutili tra i tuoi alleati dal momento che siamo tutti insieme in questa prigione."&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005055Z" creationid="demon" creationdate="20261118T005055Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Scusami?" La principessa mercante chiese con serietà, quasi ringhiando sotto al respiro.&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005051Z" creationid="demon" creationdate="20261118T005051Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Se quel tipo di mostro ha ucciso Rein allora nessuno di noi ha una chance contro di lui."&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005048Z" creationid="demon" creationdate="20261118T005048Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Seh, ho incontrato l'idiota in precedenza.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005052Z" creationid="demon" creationdate="20261118T005052Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Sono d'accordo con te.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005050Z" creationid="demon" creationdate="20261118T005050Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Svegliati, Subaru… " La voce implorò, sofferenza e incredulità chiare nel suo tono.&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005044Z" creationid="demon" creationdate="20261118T005044Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>"Sì, questo imbecille mi ha salvato da una signora davvero pericolosa alcuni mesi fa.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005052Z" creationid="demon" creationdate="20261118T005052Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;em&gt;È&lt;/em&gt; effettivamente una bassa probabilità quella che tutte queste personalità fossero presenti in un luogo così remoto.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005051Z" creationid="demon" creationdate="20261118T005051Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005103Z" creationid="demon" creationdate="20261118T003036Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;[fuzzy]Capitolo 2: Ep 1 Director's Cut &lt;p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"&lt;em&gt;Tutti&lt;/em&gt; in questa stanza sembrano essere stati massacrati da questo assassino… Eccetto Subaru-dono." Un vecchio uomo con penetranti occhi blu mormorò attentamente e con serietà.&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005049Z" creationid="demon" creationdate="20261118T005049Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"C'ho già provato per un po' ragazzetta!</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005046Z" creationid="demon" creationdate="20261118T005046Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"Calmati Mimi!"&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005056Z" creationid="demon" creationdate="20261118T005056Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"Capisco.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005053Z" creationid="demon" creationdate="20261118T005053Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"Cavolo, questo ragazzino sembra tirarsi addosso sempre un sacco di problemi, huh?" Un uomo-cane dall'aspetto esuberante scherzosamente con un sorrisetto, provando ad alleggerire l'atmosfera.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005041Z" creationid="demon" creationdate="20261118T005041Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"Che cazzo?!"&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005056Z" creationid="demon" creationdate="20261118T005056Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"Che noia!</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005047Z" creationid="demon" creationdate="20261118T005047Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"Che troia." Felt soffiò grezzamente mentre fissava la nobile fastidiosa.&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005055Z" creationid="demon" creationdate="20261118T005055Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"Cos'era quello?!"&lt;/p&gt;</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005056Z" creationid="demon" creationdate="20261118T005056Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"Cos'è questo, oserei dire?!</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005042Z" creationid="demon" creationdate="20261118T005042Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"Hey, è nella mia testa!</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005056Z" creationid="demon" creationdate="20261118T005056Z">
        <seg>&lt;p&gt;&lt;em&gt;"Non capisco… non ci sono neanche razze miste nel suo mondo?" Felix chiese all'unica persona disposta a rispondere a una tale domanda.&lt;/em&gt;&lt;/p&gt;</seg>
      </tuv>
    </tu>
    <tu>
      <tuv lang="en-US">
        <seg>&lt;p&gt;"Hm, sono d'accoooordo che la possibilità che tutti noi fossimo andati a fare un picnic e che avessimo incontrato improvvisamente questa bestia sia altamente improbaaaaabile." Un uomo dall'aspetto eccentrico e la faccia da clown diede voce al suo assenso mentre la sua utile domestica dai capelli rosa annuì cortesemente.</seg>
      </tuv>
      <tuv lang="it-IT" changeid="demon" changedate="20261118T005050Z" creationid="demon" creationdate="20261118T005050Z">
